.next/
out/

# build output
build
dist

# turborepo
.turbo

# where the round bank images used to live, before they moved into the S3
# bucket. Nothing writes here any more; the rule stays so a restored backup or
# a pre-migration checkout cannot put 100MB of pictures into a commit.
apps/game/data/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers brainstorming companion (local mockups, not source)
.superpowers/
