# The one thing between the internet and a delete button. Required: the admin
# refuses to sign anybody in without it. Sessions are a cookie signed with a
# key derived from this, so changing it signs everybody out.
ADMIN_PASSWORD=

# The Postgres the round bank lives in — the SAME database the game server
# reads and the fill tool writes. If unset here, the value in apps/game/.env
# is used, like the fill tool does, so one URL in one place is enough locally.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/guessly

# The bucket the round bank's pictures live in — the same one the game server
# reads. The admin reads pictures out of it to show them, writes one when a
# picture is replaced, and deletes one when the last round showing it goes.
# If unset here, the values in apps/game/.env are used, like DATABASE_URL.
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=guessly-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=garage
