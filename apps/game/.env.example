PORT=3001
# Explicit origin allowlist for Socket.IO, comma separated. Never "*".
CORS_ORIGINS=http://localhost:3000

# Rounds are built by Claude — the server refuses to start without this.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Where the round bank lives (SQLite file + downloaded images). Defaults to
# apps/game/data. A deploy must point this at a disk that survives restarts.
# DATA_DIR=/var/lib/guessly

# The origin a player's browser reaches this server on — banked images are
# served from here. Defaults to http://localhost:<PORT>.
# PUBLIC_BASE_URL=https://game.example.com
