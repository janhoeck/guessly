PORT=3001
# Explicit origin allowlist for Socket.IO, comma separated. Never "*".
CORS_ORIGINS=http://localhost:3000

# No AI credentials here: the server never calls the AI. The fill tool
# (tools/fill) owns DEEPSEEK_API_KEY — see tools/fill/.env.example. (It also
# reads this file as a fallback, so a key that already lives here keeps
# working.)

# The Postgres the round bank lives in — the same database the fill tool
# writes. Required.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/guessly

# The bucket the round bank's pictures live in — the same one the fill tool
# writes. All four are required: the server carries nothing on disk, so a
# missing bucket is a server with no pictures rather than a slower one.
#
# The bucket stays PRIVATE. Players never reach it: the server reads objects
# out of it and serves them from its own origin at /img/<hash>.<ext>.
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=guessly-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional. Whatever the store calls its region — Garage's own default, and
# the Coolify template's, is "garage". Defaults to "garage".
# S3_REGION=garage

# The origin a player's browser reaches this server on — banked images are
# served from here. Defaults to http://localhost:<PORT>.
# PUBLIC_BASE_URL=https://game.example.com
