{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Tests have no business in dist. tsconfig.typecheck.json still type checks them.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
