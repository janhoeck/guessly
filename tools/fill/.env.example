# The fill tool is the only process that talks to Claude; the game server
# never does. If this file does not exist, apps/game/.env is read instead, so
# one key in one place is enough for local development.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Where the round bank lives. Must be the SAME directory the game server
# serves from — the whole point is filling its shelves. Defaults to
# apps/game/data.
# DATA_DIR=/var/lib/guessly
