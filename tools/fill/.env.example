# The fill tool is the only process that talks to DeepSeek; the game server
# never does. If this file does not exist, apps/game/.env is read instead, so
# one key in one place is enough for local development.
DEEPSEEK_API_KEY=sk-...
# Optional. Defaults to deepseek-v4-pro; deepseek-v4-flash is the cheaper option.
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional. How hard the model thinks per round: none, low, high or max.
# Defaults to low — the thinking is most of a round's latency and cost, and
# the fill loop's validation-and-retry is what guards quality. Raise it if
# the log shows rejects climbing; "none" turns thinking off entirely.
# DEEPSEEK_REASONING_EFFORT=low

# The Postgres the round bank lives in. Must be the SAME database the game
# server reads — the whole point is filling its shelves. If unset here, the
# value in apps/game/.env is used, like the API key above.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/guessly

# Where the bank's downloaded images go. Must be the SAME directory the game
# server serves from. Defaults to apps/game/data.
# DATA_DIR=/var/lib/guessly
