{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json"],
  // Turbo runs tasks in strict env mode, so a variable the shell exports does
  // not reach a task unless it is named. These are runtime configuration rather
  // than build inputs, and some of them are secrets, so they are passed through
  // rather than hashed into a cache key — `dev`, `start`, `fill` and
  // `migrate:images` are uncached anyway. Local development reads
  // apps/game/.env instead; see config.ts. The AI credentials belong to `fill`
  // alone: the server never generates a round. The bucket belongs to all of
  // them, because the pictures are one bucket however many processes read it.
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_SOCKET_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "PUBLIC_BASE_URL",
        "NEXT_PUBLIC_SOCKET_URL"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "PUBLIC_BASE_URL",
        "NEXT_PUBLIC_SOCKET_URL"
      ]
    },
    "fill": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_MODEL",
        "DEEPSEEK_REASONING_EFFORT",
        "DATABASE_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY"
      ]
    },
    // The one-way move of the old on-disk pictures into the bucket. DATA_DIR
    // survives here and nowhere else: it is how the script is told where the
    // files *were*, and no process reads it to decide anything any more.
    "migrate:images": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATA_DIR",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
