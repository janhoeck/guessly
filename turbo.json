{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json"],
  // Turbo runs tasks in strict env mode, so a variable the shell exports does
  // not reach a task unless it is named. These are runtime configuration rather
  // than build inputs, and one of them is a secret, so they are passed through
  // rather than hashed into a cache key — `dev`, `start` and `fill` are
  // uncached anyway. Local development reads apps/game/.env instead; see
  // config.ts. The AI credentials belong to `fill` alone: the server never
  // generates a round.
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_SOCKET_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "CORS_ORIGINS",
        "DATA_DIR",
        "PUBLIC_BASE_URL",
        "NEXT_PUBLIC_SOCKET_URL"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "CORS_ORIGINS",
        "DATA_DIR",
        "PUBLIC_BASE_URL",
        "NEXT_PUBLIC_SOCKET_URL"
      ]
    },
    "fill": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ANTHROPIC_API_KEY", "ANTHROPIC_MODEL", "DATA_DIR"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
